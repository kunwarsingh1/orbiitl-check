{
  "name": "production-checker",
  "version": "0.1.0",
  "description": "CLI tool that audits deployed Node/Python web apps for production-readiness leaks: exposed origin IPs behind Cloudflare/CDN, leaked node_modules/source files, sourcemaps, .env, .git, and other dev artifacts.",
  "bin": {
    "production-checker": "dist/cli.js"
  },
  "type": "module",
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "kunwarsingh1 <kunwarsingh040126@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunwarsingh1/production-checker.git"
  },
  "bugs": {
    "url": "https://github.com/kunwarsingh1/production-checker/issues"
  },
  "homepage": "https://github.com/kunwarsingh1/production-checker#readme",
  "keywords": [
    "security",
    "cli",
    "production",
    "cloudflare",
    "origin-ip",
    "node_modules",
    "sourcemap",
    "recon",
    "pentest",
    "owasp"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  }
}
